# ===== OneBot v11 / NoneBot (run a NapCat/Lagrange OneBot v11 impl, reverse-WS to here) =====
# NoneBot listens here; the OneBot impl connects to ws://HOST:PORT/onebot/v11/ws
HOST=127.0.0.1
PORT=8080

# ===== Who can trigger the bot =====
# QQ user IDs that trigger a reply when they @bot. Comma-separated.
TARGET_USER_IDS=123456789
# Optional: restrict to these group IDs (empty = every group).
TARGET_GROUP_IDS=
# Optional: in these groups, ANY member triggers the bot by @mentioning it.
ALL_USERS_GROUP_IDS=

# ===== Upstream Responses-compatible API (bot posts to API_BASE_URL/responses) =====
API_BASE_URL=https://api.openai.com/v1
API_KEY=replace-with-your-key
API_MODEL=gpt-4o-mini
# Optional reasoning effort (low/medium/high). Empty = none.
API_REASONING_EFFORT=
# Protocol: "responses" (OpenAI Responses API) or "chat" (Chat Completions — DeepSeek/智谱/通义).
API_STYLE=responses

# ===== Prompts =====
SYSTEM_PROMPT=你是一个友善、简洁的 QQ 群助手。请直接回答用户的问题。
# Used only by `公共` conversations. Empty falls back to SYSTEM_PROMPT.
PUBLIC_SYSTEM_PROMPT=
# Used only by the exact personal command `评分`.
RATING_SYSTEM_PROMPT=
# Optional fixed example turn for personal conversations (both must be set to activate).
PREFILL_USER=
PREFILL_ASSISTANT=
# Optional fixed example turn for `公共` conversations.
PUBLIC_PREFILL_USER=
PUBLIC_PREFILL_ASSISTANT=

# ===== Conversation limits =====
API_TIMEOUT_SECONDS=90
LLM_SHORT_TIMEOUT_SECONDS=15
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_TURNS=20
MAX_PUBLIC_CONVERSATION_MESSAGES=500
# Persistence: "memory" (lost on restart) or "sqlite" (survives restart).
MEMORY_BACKEND=memory
SQLITE_PATH=data/memory.sqlite
# Context compaction: when a personal history reaches SUMMARIZE_AT_MESSAGES, fold the oldest
# SUMMARIZE_BATCH into a running summary (injected into the prompt as data). Off by default.
SUMMARIZE_ENABLED=false
SUMMARIZE_AT_MESSAGES=28
SUMMARIZE_BATCH=16
SUMMARIZE_MODEL=

# ===== Reliability / cost guardrails =====
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=20
# Hard cap on upstream API calls per calendar day (Asia/Shanghai). 0 = disabled.
BUDGET_DAILY_API_CALLS=0

# ===== Status notifications (online/offline, sent to these groups) =====
STATUS_GROUP_IDS=
ONLINE_MESSAGE=
OFFLINE_MESSAGE=
# In-character fallback shown on upstream/error/budget failures (override with your own flavor).
FALLBACK_UPSTREAM=nya…脑子卡住了，等会儿再来戳我喵
FALLBACK_GENERIC=呜…nya晕过去了，叫管理员来把我弄醒喵
FALLBACK_BUDGET=nya今天被聊累啦，明天再来吧喵
